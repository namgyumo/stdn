---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const problems = (await getCollection('problems')).sort(
  (a, b) => a.data.tierNum - b.data.tierNum || a.data.number - b.data.number,
);

const TIER_LABEL: Record<string, string> = {
  B3: '브론즈 III', B2: '브론즈 II', B1: '브론즈 I',
  S5: '실버 V', S4: '실버 IV', S3: '실버 III', S2: '실버 II', S1: '실버 I',
  G5: '골드 V', G4: '골드 IV', G3: '골드 III',
};
const TIER_ORDER = ['B3', 'B2', 'B1', 'S5', 'S4', 'S3', 'S2', 'S1', 'G5', 'G4', 'G3'];
const GROUPS = [
  { key: 'all', label: '전체' },
  { key: 'B', label: '브론즈' },
  { key: 'S', label: '실버' },
  { key: 'G', label: '골드' },
];

// 통계
const total = problems.length;
const byTier = TIER_ORDER
  .map((t) => ({ tier: t, count: problems.filter((p) => p.data.tier === t).length }))
  .filter((x) => x.count > 0);
const tagCount = new Map<string, number>();
for (const p of problems) for (const t of p.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const topTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
const allTags = topTags.map(([t]) => t);
---

<BaseLayout
  title="Algorithm Bank"
  description="std::N 이 직접 풀고 정리한 실버 난도 알고리즘 문제 은행. 브라우저에서 바로 코드를 작성하고 채점받을 수 있습니다."
>
  <section class="container" style="padding-top: 56px;">
    <header class="bank-head">
      <p class="eyebrow">// algorithm bank</p>
      <h1 class="h1">Algorithm Bank</h1>
      <p class="bank-sub">
        직접 풀고 정리한 <strong>{total}</strong>개의 실버 난도 문제.
        브라우저에서 C · C++ · Python 으로 작성하고 <strong>바로 채점</strong>됩니다.
      </p>
    </header>

    <div class="bank-stats">
      <div class="stat-card stat-total">
        <span class="stat-num">{total}</span>
        <span class="stat-label">solved problems</span>
      </div>
      <div class="stat-card">
        <div class="tier-bars">
          {byTier.map(({ tier, count }) => (
            <div class="tier-bar">
              <span class={`tier-badge tier-${tier}`}>{TIER_LABEL[tier]}</span>
              <span class="tier-bar-track">
                <span
                  class={`tier-bar-fill fill-${tier[0]}`}
                  style={`width:${Math.max(...byTier.map((x) => x.count)) ? (count / Math.max(...byTier.map((x) => x.count))) * 100 : 0}%`}
                ></span>
              </span>
              <span class="tier-bar-n">{count}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="stat-card stat-tags">
        <span class="stat-label">top tags</span>
        <div class="tag-cloud">
          {topTags.slice(0, 8).map(([t, n]) => <span class="tag-pill">{t} <b>{n}</b></span>)}
        </div>
      </div>
    </div>

    <div class="bank-controls">
      <input type="search" id="bank-search" class="bank-search" placeholder="문제 검색 (제목·번호·태그)" autocomplete="off" />
      <div class="tier-filter" role="group" aria-label="티어 필터">
        {GROUPS.map((g, i) => (
          <button class={`chip${i === 0 ? ' is-on' : ''}`} data-group={g.key}>{g.label}</button>
        ))}
      </div>
      <select id="bank-tag" class="bank-select" aria-label="태그 필터">
        <option value="all">모든 태그</option>
        {allTags.map((t) => <option value={t}>{t}</option>)}
      </select>
    </div>

    <ul class="bank-list" id="bank-list">
      {problems.map((p) => (
        <li
          class="bank-row"
          data-title={p.data.title}
          data-number={p.data.number}
          data-tier={p.data.tier}
          data-tags={p.data.tags.join(',')}
        >
          <a href={`/bank/${p.id}`}>
            <span class="row-num">#{String(p.data.number).padStart(2, '0')}</span>
            <span class={`tier-badge tier-${p.data.tier}`}>{TIER_LABEL[p.data.tier]}</span>
            <span class="row-title">{p.data.title}</span>
            <span class="row-tags">
              {p.data.tags.map((t) => <span class="row-tag">{t}</span>)}
            </span>
            <span class="row-go">풀기 →</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="bank-empty" id="bank-empty" hidden>조건에 맞는 문제가 없습니다.</p>
  </section>

  <script is:inline data-astro-rerun>
    (() => {
      const list = document.getElementById('bank-list');
      if (!list) return;
      const rows = [...list.querySelectorAll('.bank-row')];
      const search = document.getElementById('bank-search');
      const tagSel = document.getElementById('bank-tag');
      const empty = document.getElementById('bank-empty');
      const chips = [...document.querySelectorAll('.tier-filter .chip')];
      let group = 'all';

      const apply = () => {
        const q = (search?.value ?? '').trim().toLowerCase();
        const tag = tagSel?.value ?? 'all';
        let shown = 0;
        for (const row of rows) {
          const d = row.dataset;
          const okTier = group === 'all' || (d.tier ?? '')[0] === group;
          const okTag = tag === 'all' || (d.tags ?? '').split(',').includes(tag);
          const hay = `${d.title} ${d.number} ${d.tags}`.toLowerCase();
          const okQ = !q || hay.includes(q);
          const show = okTier && okTag && okQ;
          row.hidden = !show;
          if (show) shown++;
        }
        if (empty) empty.hidden = shown !== 0;
      };

      search?.addEventListener('input', apply);
      tagSel?.addEventListener('change', apply);
      chips.forEach((c) =>
        c.addEventListener('click', () => {
          chips.forEach((x) => x.classList.remove('is-on'));
          c.classList.add('is-on');
          group = c.dataset.group;
          apply();
        }),
      );
    })();
  </script>
</BaseLayout>

<style>
  .bank-head { margin-bottom: 30px; }
  .bank-sub { color: var(--color-fg-dim); margin-top: 10px; max-width: 60ch; line-height: 1.6; }
  .bank-sub strong { color: var(--color-accent); }

  .bank-stats {
    display: grid;
    grid-template-columns: 160px 1fr 1fr;
    gap: 14px;
    margin-bottom: 34px;
  }
  .stat-card {
    padding: 18px 20px;
    border: 1px solid rgba(224, 247, 250, 0.1);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elev);
  }
  .stat-total { display: flex; flex-direction: column; justify-content: center; align-items: center; }
  .stat-num { font-family: var(--font-mono); font-size: 2.8rem; font-weight: 700; color: var(--color-accent); line-height: 1; }
  .stat-label { display: block; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 1px; color: var(--color-fg-dim); text-transform: uppercase; margin-bottom: 10px; }
  .stat-total .stat-label { margin: 8px 0 0; }

  .tier-bars { display: grid; gap: 7px; }
  .tier-bar { display: grid; grid-template-columns: 78px 1fr 24px; align-items: center; gap: 10px; }
  .tier-bar-track { height: 8px; border-radius: 999px; background: rgba(224, 247, 250, 0.07); overflow: hidden; }
  .tier-bar-fill { display: block; height: 100%; background: linear-gradient(90deg, #7d8ca3, #cfd8e3); }
  .tier-bar-fill.fill-B { background: linear-gradient(90deg, #8a5a38, #c98a5e); }
  .tier-bar-fill.fill-S { background: linear-gradient(90deg, #7d8ca3, #cfd8e3); }
  .tier-bar-fill.fill-G { background: linear-gradient(90deg, #a6832f, #f4d76c); }
  .tier-bar-n { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-fg-dim); text-align: right; }

  .tag-cloud { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag-pill { font-family: var(--font-mono); font-size: 0.72rem; padding: 3px 8px; border: 1px solid rgba(224, 247, 250, 0.12); border-radius: var(--radius-pill); color: var(--color-fg-dim); }
  .tag-pill b { color: var(--color-fg); font-weight: 600; }

  /* 티어 배지 — 실버 계열 음영 */
  .tier-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    white-space: nowrap;
    border: 1px solid;
  }
  .tier-B3 { color: #c98a5e; border-color: #6e4a30; background: rgba(201, 138, 94, 0.08); }
  .tier-B2 { color: #d29669; border-color: #7a5236; background: rgba(210, 150, 105, 0.09); }
  .tier-B1 { color: #dca678; border-color: #875c3e; background: rgba(220, 166, 120, 0.10); }
  .tier-S5 { color: #9aa6b2; border-color: #4a525c; background: rgba(154, 166, 178, 0.08); }
  .tier-S4 { color: #a8b4c0; border-color: #545d68; background: rgba(168, 180, 192, 0.09); }
  .tier-S3 { color: #b8c4d0; border-color: #5e6874; background: rgba(184, 196, 208, 0.10); }
  .tier-S2 { color: #c8d4e0; border-color: #68727e; background: rgba(200, 212, 224, 0.11); }
  .tier-S1 { color: #dce6f0; border-color: #7a8490; background: rgba(220, 230, 240, 0.13); }
  .tier-G5 { color: #e8c15a; border-color: #8a6f2a; background: rgba(232, 193, 90, 0.09); }
  .tier-G4 { color: #eecb62; border-color: #98792e; background: rgba(238, 203, 98, 0.10); }
  .tier-G3 { color: #f4d76c; border-color: #a68533; background: rgba(244, 215, 108, 0.12); }

  .bank-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-bottom: 20px;
  }
  .bank-search {
    flex: 1 1 240px;
    min-width: 180px;
    padding: 9px 14px;
    border: 1px solid rgba(224, 247, 250, 0.14);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elev);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .bank-search:focus { outline: none; border-color: var(--color-accent); box-shadow: var(--glow-lime-soft); }
  .tier-filter { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    padding: 7px 12px;
    border: 1px solid rgba(224, 247, 250, 0.14);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-fg-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease);
  }
  .chip:hover { color: var(--color-fg); border-color: rgba(224, 247, 250, 0.3); }
  .chip.is-on { color: var(--color-bg); background: var(--color-accent); border-color: var(--color-accent); font-weight: 600; }
  .bank-select {
    padding: 9px 12px;
    border: 1px solid rgba(224, 247, 250, 0.14);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elev);
    color: var(--color-fg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .bank-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(224, 247, 250, 0.08); }
  .bank-row { border-bottom: 1px solid rgba(224, 247, 250, 0.08); }
  .bank-row[hidden] { display: none; }
  .bank-row a {
    display: grid;
    grid-template-columns: 52px 74px 1fr auto auto;
    align-items: center;
    gap: 16px;
    padding: 13px 10px;
    text-decoration: none;
    color: var(--color-fg);
    transition: background var(--dur-fast) var(--ease);
  }
  .bank-row a:hover, .bank-row a.touch-active { background: rgba(193, 255, 0, 0.05); }
  .row-num { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-fg-dim); }
  .row-title { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .row-tags { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .row-tag { font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-fg-dim); padding: 2px 7px; border: 1px solid rgba(224, 247, 250, 0.1); border-radius: 4px; }
  .row-go { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-accent); opacity: 0; transition: opacity var(--dur-fast) var(--ease); }
  .bank-row a:hover .row-go, .bank-row a.touch-active .row-go { opacity: 1; }
  .bank-empty { text-align: center; color: var(--color-fg-dim); padding: 40px 0; }

  @media (max-width: 820px) {
    .bank-stats { grid-template-columns: 1fr; }
    .row-tags { display: none; }
  }
  @media (max-width: 560px) {
    .bank-row a { grid-template-columns: 44px 66px 1fr; gap: 10px; }
    .row-go { display: none; }
  }
</style>
