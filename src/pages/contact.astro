---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@lib/site';

const cards = [
  {
    icon: 'GitHub',
    label: '코드와 작업 기록',
    detail: 'github.com/namgyumo',
    href: site.author.github,
    external: true,
  },
  {
    icon: 'Email',
    label: '메일 보내기',
    detail: site.author.email,
    href: `mailto:${site.author.email}`,
    external: false,
  },
  {
    icon: 'Instagram',
    label: '메시지 보내기',
    detail: '@east_scale',
    href: site.author.instagram,
    external: true,
  },
  // BOJ 서비스 종료로 비활성화
  // {
  //   icon: '[ BOJ ]',
  //   label: 'Algorithm Profile',
  //   detail: `solved.ac/${site.author.boj}`,
  //   href: `https://solved.ac/${site.author.boj}`,
  //   external: true,
  // },
];
---

<BaseLayout
  title="Contact"
  description="std::N 과 연락하는 방법 — GitHub, Email, Instagram."
>
  <section class="container contact-hero">
    <p class="eyebrow">contact</p>
    <h1 class="h1">연락</h1>
    <p class="h2">질문이나 제안이 있다면 편하게 남겨 주세요.</p>
  </section>

  <section class="container">
    <div class="contact-section">
      <div class="contact-heading">
        <h2 class="section-h1">연락처</h2>
        <p>메일을 가장 자주 확인합니다. 편한 채널을 골라 연락해 주세요.</p>
      </div>

      <div class="contact-grid">
        {cards.map((c) => (
          <a
            href={c.href}
            class="contact-card"
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener noreferrer' : undefined}
          >
            <div class="contact-icon">{c.icon}</div>
            <div class="contact-label">{c.label}</div>
            <div class="contact-detail">{c.detail}</div>
          </a>
        ))}
      </div>

      <form class="contact-form" id="contact-form" name="contact" method="POST" action="/api/contact" novalidate>
        <h3 class="form-title">메시지 남기기</h3>
        <label>
          <span>이름</span>
          <input type="text" name="name" required autocomplete="name" maxlength="100" />
        </label>
        <label>
          <span>이메일</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>
          <span>내용</span>
          <textarea name="message" rows="5" required minlength="5" maxlength="5000"></textarea>
        </label>
        <label class="hp" aria-hidden="true">
          <span>Website</span>
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
        <button type="submit" class="form-submit">메시지 보내기 →</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById('contact-form');
      const status = document.getElementById('form-status');
      if (!form || !status) return;

      const ERR = {
        missing_fields: '이름·이메일·메시지를 모두 채워주세요.',
        invalid_email: '이메일 형식이 올바르지 않습니다.',
        message_too_short: '메시지가 너무 짧습니다 (5자 이상).',
        message_too_long: '메시지가 너무 깁니다 (5000자 이내).',
        name_too_long: '이름이 너무 깁니다 (100자 이내).',
        invalid_body: '요청을 해석할 수 없습니다.',
        send_failed: '메일 전송이 실패했습니다. 잠시 후 다시 시도해 주세요.',
        method_not_allowed: '잘못된 요청입니다.',
        network: '네트워크 오류. 연결을 확인하고 다시 시도해 주세요.',
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('.form-submit');
        const data = new FormData(form);
        status.className = 'form-status';
        status.textContent = '전송 중...';
        if (btn) btn.setAttribute('disabled', 'true');

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(data)),
          });
          const j = await res.json().catch(() => ({}));
          if (j.ok) {
            status.className = 'form-status ok';
            status.textContent = j.mode === 'logged'
              ? '접수 완료 (메일 연결 전 — 로그로 기록됨).'
              : '메시지 전송 완료. 답장 드리겠습니다.';
            form.reset();
          } else {
            status.className = 'form-status err';
            status.textContent = ERR[j.error] ?? '전송 실패.';
          }
        } catch {
          status.className = 'form-status err';
          status.textContent = ERR.network;
        } finally {
          if (btn) btn.removeAttribute('disabled');
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .contact-hero {
    padding-top: 64px;
  }
  .contact-hero .eyebrow { margin-bottom: 12px; }
  .contact-hero .h1 { display: block; margin-bottom: 14px; }
  .contact-hero .h2 {
    max-width: 44rem;
    margin: 0;
    color: var(--theme-muted);
    font-size: .92rem;
    line-height: 1.7;
  }
  .contact-section {
    max-width: none;
    margin: 72px 0 0;
    padding: 0;
    border: 0;
    font-family: var(--font-sans);
    backdrop-filter: none;
    animation: none;
    box-shadow: none !important;
  }
  .contact-heading { margin-bottom: 20px; }
  .contact-heading .section-h1 { display: block; margin-bottom: 12px; }
  .contact-heading p { margin: 0; color: var(--theme-muted); font-size: .84rem; }
  .contact-section .contact-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .contact-section .contact-card {
    min-height: 150px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 22px;
    text-align: left;
    border-color: var(--theme-line);
    border-radius: 4px;
    background: var(--theme-surface);
    box-shadow: none;
  }
  .contact-section .contact-card:hover {
    border-color: var(--theme-muted);
    background: var(--theme-surface-2);
    box-shadow: none;
    transform: translateY(-2px);
  }
  .contact-section .contact-icon {
    margin: 0 0 auto;
    color: var(--theme-text);
    font-family: var(--font-sans);
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -.02em;
  }
  .contact-section .contact-label {
    margin: 22px 0 5px;
    color: var(--theme-muted);
    font-size: .75rem;
    text-transform: none;
  }
  .contact-section .contact-detail {
    color: var(--theme-text);
    font-family: var(--font-mono);
    font-size: .72rem;
  }
  .contact-form {
    margin: 72px 0 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 760px;
  }
  .form-title {
    margin: 0 0 12px;
    color: var(--theme-text);
    font-family: var(--font-sans);
    font-size: 1.55rem;
    letter-spacing: -.025em;
  }
  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: .78rem;
    color: var(--color-fg-dim);
  }
  .contact-form input,
  .contact-form textarea {
    padding: 10px 14px;
    background: rgba(8, 8, 8, 0.8);
    border: 1px solid rgba(193, 255, 0, 0.25);
    border-radius: 6px;
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: .92rem;
    outline: none;
    transition: all var(--dur) var(--ease);
    resize: vertical;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 8px rgba(193, 255, 0, 0.3);
  }
  .form-submit {
    align-self: flex-start;
    margin-top: 8px;
    padding: 11px 18px;
    background: transparent;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    border-radius: 6px;
    font-family: var(--font-sans);
    font-weight: 650;
    letter-spacing: -.01em;
    cursor: pointer;
    transition: all var(--dur) var(--ease);
  }
  .form-submit:hover {
    background: rgba(193, 255, 0, 0.1);
    box-shadow: var(--glow-lime);
  }
  .form-submit[disabled] {
    opacity: 0.5;
    cursor: wait;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-status {
    margin: 0;
    min-height: 1.4em;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-fg-dim);
    text-align: center;
  }
  .form-status.ok {
    color: var(--color-accent);
  }
  .form-status.err {
    color: #ff6b6b;
  }
  @media (max-width: 700px) {
    .contact-hero { padding-top: 44px; }
    .contact-section { margin-top: 54px; }
    .contact-section .contact-grid { grid-template-columns: 1fr; }
    .contact-section .contact-card { min-height: 132px; }
    .contact-form { margin-top: 54px; }
  }
</style>
