---
import PlainBlogShell from '@layouts/PlainBlogShell.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '@lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = new Set<string>();
  for (const p of posts) for (const t of p.data.tags) tags.add(t);
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()),
    },
  }));
}

interface Props {
  tag: string;
  posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
}

const { tag, posts } = Astro.props;
const staticSlugs = posts.map((p) => p.id);
---

<PlainBlogShell title={`#${tag}`} description={`${tag} 태그의 글`}>
  <div class="tag-page">
    <section class="intro" aria-labelledby="tag-title">
      <p class="eyebrow">태그</p>
      <h1 id="tag-title">#{tag}<span>.</span></h1>
      <p><a href="/blog">← 전체 글</a></p>
    </section>

    <div class="content-grid">
      <aside class="sidebar" aria-label="태그 안내">
        <div><h2>글</h2><p><a href="/blog">전체 글 보기</a></p></div>
      </aside>
      <section class="writing" aria-labelledby="tag-writing-title">
        <div class="section-heading">
          <h2 id="tag-writing-title">#{tag}</h2>
          <span id="tag-count">{String(posts.length).padStart(2, '0')}개의 글</span>
        </div>
        <ol class="post-list" id="post-list">
          {posts.map((post) => (
            <li data-slug={post.id} data-published={post.data.publishedAt.toISOString()}>
              <a class="post" href={`/blog/${post.id}`}>
                <div class="meta"><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time><span>{post.data.tags[0] ?? '기록'}</span></div>
                <h3>{post.data.title}<span class="arrow" aria-hidden="true">↗</span></h3>
                {post.data.description && <p>{post.data.description}</p>}
              </a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>
<script is:inline define:vars={{ tag, staticSlugs }}>
  (async () => {
    try {
      const r = await fetch('/api/posts', { credentials: 'same-origin' });
      if (!r.ok) return;
      const data = await r.json();
      if (!data?.ok || !Array.isArray(data.posts)) return;

      const staticSet = new Set(staticSlugs);
      const matches = data.posts.filter(
        (p) => !staticSet.has(p.slug) && Array.isArray(p.tags) && p.tags.includes(tag),
      );
      if (matches.length === 0) return;

      const list = document.getElementById('post-list');
      const countEl = document.getElementById('tag-count');
      if (!list) return;

      for (const p of matches) {
        const li = document.createElement('li');
        li.dataset.slug = p.slug;
        li.dataset.published = p.publishedAt;
        const link = document.createElement('a');
        link.className = 'post';
        link.href = `/blog/${encodeURIComponent(p.slug)}`;
        const meta = document.createElement('div');
        meta.className = 'meta';
        const date = document.createElement('time');
        const published = new Date(p.publishedAt);
        if (!Number.isNaN(published.valueOf())) {
          date.dateTime = published.toISOString();
          date.textContent = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(published);
        }
        const topic = document.createElement('span');
        topic.textContent = p.tags[0] ?? '기록';
        meta.append(date, topic);
        const title = document.createElement('h3');
        title.textContent = p.title ?? '';
        const arrow = document.createElement('span');
        arrow.className = 'arrow';
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '↗';
        title.append(arrow);
        link.append(meta, title);
        if (p.description) {
          const description = document.createElement('p');
          description.textContent = p.description;
          link.append(description);
        }
        li.append(link);
        list.appendChild(li);
      }

      const items = [...list.querySelectorAll('li')];
      items.sort((a, b) => (b.dataset.published ?? '').localeCompare(a.dataset.published ?? ''));
      for (const el of items) list.appendChild(el);
      if (countEl) countEl.textContent = `${String(items.length).padStart(2, '0')}개의 글`;
    } catch {}
  })();
</script>
</PlainBlogShell>
