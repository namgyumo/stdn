---
import { getCollection } from 'astro:content';
import { formatDate } from '@lib/format';
import PlainBlogShell from '@layouts/PlainBlogShell.astro';

const description = '남규모의 블로그. C/C++, 자료구조, 프로젝트, 문제 풀이.';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const staticSlugs = posts.map((post) => post.id);
---

<PlainBlogShell title="블로그" description={description}>
      <section class="intro" aria-labelledby="intro-title">
        <p class="eyebrow">남규모</p>
        <h1 id="intro-title">블로그<span>.</span></h1>
        <p>C/C++ · 자료구조 · 프로젝트 · 문제 풀이</p>
      </section>

      <div class="content-grid">
        <aside class="sidebar" aria-label="블로그 안내">
          <div>
            <h2>소개</h2>
            <p>동의대학교<br />컴퓨터소프트웨어공학과 25학번</p>
          </div>
          <div class="other-links">
            <h2>다른 곳</h2>
            <a href="https://github.com/namgyumo" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            <a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
          </div>
        </aside>

        <section id="writing" class="writing" aria-labelledby="writing-title">
          <div class="section-heading">
            <h2 id="writing-title">최근 글</h2>
            <span id="post-count">{String(posts.length).padStart(2, '0')}개의 글</span>
          </div>
          {posts.length > 0 ? (
            <ol class="post-list" id="post-list">
              {posts.map((post) => (
                <li data-slug={post.id} data-published={post.data.publishedAt.toISOString()}>
                  <a class="post" href={`/blog/${post.id}`}>
                    <div class="meta"><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time><span>{post.data.tags[0] ?? '기록'}</span></div>
                    <h3>{post.data.title}<span class="arrow" aria-hidden="true">↗</span></h3>
                    {post.data.description && <p>{post.data.description}</p>}
                  </a>
                </li>
              ))}
            </ol>
          ) : <ol class="post-list" id="post-list"></ol>}

        </section>
      </div>
<script is:inline define:vars={{ staticSlugs }}>
  (async () => {
    const list = document.getElementById('post-list');
    if (!list) return;

    try {
      const response = await fetch('/api/posts', { credentials: 'same-origin' });
      if (!response.ok) return;
      const data = await response.json();
      if (!data?.ok || !Array.isArray(data.posts)) return;

      const knownSlugs = new Set(staticSlugs);
      for (const post of data.posts) {
        if (!post || typeof post.slug !== 'string' || knownSlugs.has(post.slug)) continue;
        knownSlugs.add(post.slug);

        const item = document.createElement('li');
        item.dataset.slug = post.slug;
        item.dataset.published = post.publishedAt ?? '';
        const link = document.createElement('a');
        link.className = 'post';
        link.href = `/blog/${encodeURIComponent(post.slug)}`;
        const meta = document.createElement('div');
        meta.className = 'meta';
        const date = document.createElement('time');
        const published = new Date(post.publishedAt);
        if (!Number.isNaN(published.valueOf())) {
          date.dateTime = published.toISOString();
          date.textContent = new Intl.DateTimeFormat('ko-KR', {
            year: 'numeric', month: '2-digit', day: '2-digit',
          }).format(published);
        }
        const topic = document.createElement('span');
        topic.textContent = Array.isArray(post.tags) ? (post.tags[0] ?? '기록') : '기록';
        meta.append(date, topic);
        const title = document.createElement('h3');
        title.textContent = post.title ?? '';
        const arrow = document.createElement('span');
        arrow.className = 'arrow';
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '↗';
        title.append(arrow);
        link.append(meta, title);
        if (post.description) {
          const description = document.createElement('p');
          description.textContent = post.description;
          link.append(description);
        }
        item.append(link);
        list.append(item);
      }

      const items = [...list.children];
      items.sort((a, b) => (b.dataset.published ?? '').localeCompare(a.dataset.published ?? ''));
      items.forEach((item) => list.append(item));
      document.getElementById('post-count')?.replaceChildren(`${String(items.length).padStart(2, '0')}개의 글`);
    } catch {
      // 정적 글 목록은 API 없이도 볼 수 있다.
    }
  })();
</script>
</PlainBlogShell>
