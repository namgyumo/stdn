  </div>
    </div>
    <p class="visually-hidden" data-paper-status aria-live="polite">02면 개발 노트</p>
  </section>

  <script is:inline define:vars={{ staticPosts }} data-astro-rerun>
    (() => {
      const reader = document.querySelector('[data-home-reader]');
      if (reader) {
        const sheets = [...reader.querySelectorAll('[data-home-sheet]')];
        const stage = reader.querySelector('.home-paper-stage');
        const turnButton = reader.querySelector('[data-paper-turn]');
        const currentSide = reader.querySelector('[data-current-side]');
        const turnCopy = reader.querySelector('[data-turn-copy]');
        const status = reader.querySelector('[data-paper-status]');
        const details = {
          workroom: { side: '01', title: '작업실', next: '02면 개발 노트로 넘기기' },
          notebook: { side: '02', title: '개발 노트', next: '01면 작업실로 넘기기' },
        };
        let active = localStorage.getItem('stdn-home-sheet') === 'workroom' ? 'workroom' : 'notebook';
        let turning = false;

        const syncIssueClock = () => {
          const now = new Date();
          const date = new Intl.DateTimeFormat('ko-KR', {
            timeZone: 'Asia/Seoul', year: 'numeric', month: 'long', day: 'numeric',
          }).format(now);
          const time = new Intl.DateTimeFormat('ko-KR', {
            timeZone: 'Asia/Seoul', hour: '2-digit', minute: '2-digit', hour12: false,
          }).format(now);
          reader.querySelector('[data-current-date]')?.replaceChildren(date);
          reader.querySelector('[data-current-clock]')?.replaceChildren(`부산 · ${time}`);
        };

        const applySheet = (name, announce = false) => {
          active = name;
          sheets.forEach((sheet) => { sheet.hidden = sheet.dataset.homeSheet !== name; });
          const detail = details[name];
          currentSide.textContent = `현재 ${detail.side}면`;
          turnCopy.textContent = detail.next;
          turnButton.setAttribute('aria-label', detail.next);
          if (announce) status.textContent = `${detail.side}면 ${detail.title}`;
          localStorage.setItem('stdn-home-sheet', name);
        };

        const clearDraggedStyle = (sheet) => {
          if (!sheet) return;
          sheet.style.removeProperty('transform');
          sheet.style.removeProperty('opacity');
          sheet.style.removeProperty('filter');
          sheet.style.removeProperty('transform-origin');
          if (!sheet.getAttribute('style')?.trim()) sheet.removeAttribute('style');
        };

        const turnSheet = async (direction = -1, dragOffset = 0) => {
          if (turning) return;
          const scrollPosition = window.scrollY;
          const next = active === 'workroom' ? 'notebook' : 'workroom';
          const outgoing = sheets.find((sheet) => !sheet.hidden);
          const incoming = sheets.find((sheet) => sheet.dataset.homeSheet === next);
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const directionSign = direction < 0 ? -1 : 1;
          if (!outgoing || !incoming || reduceMotion || !outgoing.animate) {
            clearDraggedStyle(outgoing);
            applySheet(next, true);
            window.scrollTo({ top: scrollPosition, behavior: 'instant' });
            return;
          }

          turning = true;
          turnButton.disabled = true;
          reader.classList.add('is-turning');
          try {
            const stageWidth = Math.max(stage?.clientWidth ?? window.innerWidth, 1);
            const startTranslate = dragOffset ? dragOffset * .34 : 0;
            const startRotate = dragOffset ? (dragOffset / stageWidth) * 10 : 0;
            const startOpacity = dragOffset ? Math.max(.72, 1 - Math.abs(dragOffset) / stageWidth * .45) : 1;
            const outgoingAnimation = outgoing.animate([
              { opacity: startOpacity, transform: `perspective(1600px) translateX(${startTranslate}px) rotateY(${startRotate}deg)`, filter: 'brightness(1)' },
              { opacity: .08, transform: `perspective(1600px) translateX(${directionSign * 2.2}%) rotateY(${directionSign * 7}deg)`, filter: 'brightness(.84)' },
            ], { duration: 210, easing: 'cubic-bezier(.4,0,.7,.2)', fill: 'forwards' });
            await outgoingAnimation.finished;
            outgoingAnimation.cancel();
            clearDraggedStyle(outgoing);
            applySheet(next, true);
            const incomingAnimation = incoming.animate([
              { opacity: .08, transform: `perspective(1600px) translateX(${-directionSign * 2.2}%) rotateY(${-directionSign * 7}deg)`, filter: 'brightness(.84)' },
              { opacity: 1, transform: 'perspective(1600px) rotateY(0deg) translateX(0)', filter: 'brightness(1)' },
            ], { duration: 260, easing: 'cubic-bezier(.2,.75,.2,1)' });
            await incomingAnimation.finished;
            incomingAnimation.cancel();
          } finally {
            reader.classList.remove('is-turning');
            turnButton.disabled = false;
            turning = false;
            clearDraggedStyle(outgoing);
            clearDraggedStyle(incoming);
            window.scrollTo({ top: scrollPosition, behavior: 'instant' });
          }
        };

        const textAtPoint = (x, y) => {
          let node = null;
          let offset = 0;
          if (document.caretPositionFromPoint) {
            const position = document.caretPositionFromPoint(x, y);
            node = position?.offsetNode ?? null;
            offset = position?.offset ?? 0;
          } else if (document.caretRangeFromPoint) {
            const position = document.caretRangeFromPoint(x, y);
            node = position?.startContainer ?? null;
            offset = position?.startOffset ?? 0;
          }
          if (!node || node.nodeType !== Node.TEXT_NODE || !node.textContent) return false;

          const candidates = [offset - 1, offset].filter((index) => index >= 0 && index < node.textContent.length);
          return candidates.some((index) => {
            if (!/\S/.test(node.textContent[index])) return false;
            const range = document.createRange();
            range.setStart(node, index);
            range.setEnd(node, index + 1);
            return [...range.getClientRects()].some((rect) => (
              x >= rect.left - 2 && x <= rect.right + 2 && y >= rect.top - 2 && y <= rect.bottom + 2
            ));
          });
        };

        let gesture = null;
        const interactive = 'a, button, input, textarea, select, label, img, video, iframe, [contenteditable="true"]';
        const selectableText = 'h1, h2, h3, h4, p, li, dt, dd, blockquote, figcaption, code, pre, span, small, strong, em, b, time';

        stage?.addEventListener('pointerdown', (event) => {
          if (turning || !event.isPrimary || event.button !== 0) return;
          if (
            event.target.closest(interactive)
            || event.target.closest(selectableText)
            || textAtPoint(event.clientX, event.clientY)
          ) return;
          const sheet = sheets.find((item) => !item.hidden);
          if (!sheet) return;
          gesture = {
            pointerId: event.pointerId,
            startX: event.clientX,
            startY: event.clientY,
            lastX: event.clientX,
            sheet,
            dragging: false,
          };
        });

        stage?.addEventListener('pointermove', (event) => {
          if (!gesture || gesture.pointerId !== event.pointerId) return;
          const dx = event.clientX - gesture.startX;
          const dy = event.clientY - gesture.startY;
          gesture.lastX = event.clientX;

          if (!gesture.dragging) {
            if (Math.abs(dx) < 9 && Math.abs(dy) < 9) return;
            if (Math.abs(dx) <= Math.abs(dy) * 1.15) {
              gesture = null;
              return;
            }
            gesture.dragging = true;
            stage.setPointerCapture(event.pointerId);
            stage.classList.add('is-dragging');
          }

          event.preventDefault();
          const width = Math.max(stage.clientWidth, 1);
          const limited = Math.max(-width * .42, Math.min(width * .42, dx));
          const translated = limited * .34;
          const rotated = (limited / width) * 10;
          gesture.sheet.style.transformOrigin = limited < 0 ? 'left top' : 'right top';
          gesture.sheet.style.transform = `perspective(1600px) translateX(${translated}px) rotateY(${rotated}deg)`;
          gesture.sheet.style.opacity = String(Math.max(.72, 1 - Math.abs(limited) / width * .45));
          gesture.sheet.style.filter = `brightness(${Math.max(.9, 1 - Math.abs(limited) / width * .12)})`;
        }, { passive: false });

        const finishGesture = async (event, cancelled = false) => {
          if (!gesture || gesture.pointerId !== event.pointerId) return;
          const current = gesture;
          gesture = null;
          if (!current.dragging) return;
          event.preventDefault();
          stage.classList.remove('is-dragging');
          if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);

          const dx = current.lastX - current.startX;
          const threshold = Math.min(118, stage.clientWidth * .18);
          if (!cancelled && Math.abs(dx) >= threshold) {
            await turnSheet(Math.sign(dx), dx);
            return;
          }

          const resetAnimation = current.sheet.animate([
            { transform: current.sheet.style.transform, opacity: current.sheet.style.opacity || 1, filter: current.sheet.style.filter || 'none' },
            { transform: 'perspective(1600px) translateX(0) rotateY(0)', opacity: 1, filter: 'brightness(1)' },
          ], { duration: 220, easing: 'cubic-bezier(.2,.75,.2,1)' });
          await resetAnimation.finished.catch(() => {});
          resetAnimation.cancel();
          clearDraggedStyle(current.sheet);
        };

        stage?.addEventListener('pointerup', (event) => finishGesture(event));
        stage?.addEventListener('pointercancel', (event) => finishGesture(event, true));

        applySheet(active);
        syncIssueClock();
        const clockTimer = window.setInterval(syncIssueClock, 30_000);
        document.addEventListener('astro:before-swap', () => window.clearInterval(clockTimer), { once: true });
        turnButton.addEventListener('click', () => turnSheet(-1));
      }

      const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[char]));
      const formatDate = (iso) => {
        const date = new Date(iso);
        return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
      };
      const renderLists = (items) => {
        document.querySelectorAll('[data-home-post-list]').forEach((list) => {
          list.innerHTML = items.slice(0, 3).map((post) => `<li><a href="/blog/${encodeURIComponent(post.slug)}"><span>${formatDate(post.publishedAt)}</span><strong>${escapeHtml(post.title)}</strong><b>↗</b></a></li>`).join('');
        });
      };
      fetch('/api/posts', { credentials: 'same-origin' })
        .then((response) => response.ok ? response.json() : null)
        .then((data) => {
          if (!data?.ok || !Array.isArray(data.posts)) return;
          const bySlug = new Map(staticPosts.map((post) => [post.slug, post]));
          data.posts.forEach((post) => { if (!bySlug.has(post.slug)) bySlug.set(post.slug, post); });
          const merged = [...bySlug.values()].sort((a, b) => String(b.publishedAt).localeCompare(String(a.publishedAt)));
          renderLists(merged);
        })
        .catch(() => {});
    })();
  </script>
</BaseLayout>

<script>
  function initHomeBostonGallery() {
    const gallery = document.querySelector<HTMLButtonElement>('[data-home-boston-gallery]');
    if (!gallery || gallery.dataset.bound === 'true') return;
    gallery.dataset.bound = 'true';
    const photos = JSON.parse(gallery.dataset.photos ?? '[]') as Array<{ src: string; alt: string }>;
    const image = gallery.querySelector<HTMLImageElement>('[data-home-boston-image]');
    const count = gallery.querySelector<HTMLElement>('[data-home-boston-count]');
    if (!image || !count || photos.length === 0) return;
    let index = 0;
    gallery.addEventListener('click', () => {
      index = (index + 1) % photos.length;
      image.src = photos[index].src;
      image.alt = photos[index].alt;
      count.textContent = `Boston · ${String(index + 1).padStart(2, '0')} / ${String(photos.length).padStart(2, '0')}`;
    });
  }

  initHomeBostonGallery();
  document.addEventListener('astro:page-load', initHomeBostonGallery);
</script>

