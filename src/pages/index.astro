---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatShortDate } from '@lib/format';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const allProjects = (await getCollection('projects')).sort(
  (a, b) => (b.data.order ?? 0) - (a.data.order ?? 0),
);

const posts = allPosts.slice(0, 3);
const cEditor = allProjects.find((project) => project.id === 'c-note-editor');
const pikaBuddy = allProjects.find((project) => project.id === 'pikabuddy');
const dataStructure = allProjects.find((project) => project.id === 'data-structure');

const staticPosts = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  publishedAt: post.data.publishedAt.toISOString(),
  tags: post.data.tags,
}));

const homeBostonPhotos = [
  { src: '/images/boston-charles-river.jpg', alt: '찰스강 너머의 보스턴 스카이라인' },
  { src: '/images/boston-acorn-street.jpg', alt: '보스턴 비컨힐의 붉은 벽돌길' },
  { src: '/images/boston-common.jpg', alt: '봄날의 보스턴 커먼 공원' },
  { src: '/images/boston-fan-pier.jpg', alt: '팬 피어에서 바라본 보스턴 항구' },
];

const currentMoment = new Date();
const currentIssueDate = new Intl.DateTimeFormat('ko-KR', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(currentMoment);
const currentIssueTime = new Intl.DateTimeFormat('ko-KR', {
  timeZone: 'Asia/Seoul',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(currentMoment);
---

<BaseLayout
  title={undefined}
  description="저수준을 공부하고 직접 구현하는 걸 좋아하는 동의대 컴퓨터소프트웨어공학과 남규모의 포트폴리오와 개발 기록."
>
  <section class="home-reader" data-home-reader>
    <header class="paper-switcher">
      <div class="paper-switcher__title">
        <span>std::N journal</span>
        <strong>남규모의 개발 신문</strong>
      </div>
      <div class="paper-switcher__issue" aria-label="발행 정보">
        <span data-current-date>{currentIssueDate}</span>
        <span data-current-clock>부산 · {currentIssueTime}</span>
      </div>
      <button
        class="paper-turn"
        type="button"
        data-paper-turn
        aria-controls="home-paper-stage"
        title="버튼을 누르거나 빈 지면을 좌우로 끌어 넘기기"
      >
        <span>
          <small data-current-side>현재 02면</small>
          <strong data-turn-copy>01면 작업실로 넘기기</strong>
        </span>
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path d="M7.5 5.5h13l4 4v17h-17z"></path>
          <path d="M20.5 5.5v4h4M12 14h8M12 18h8M12 22h5"></path>
        </svg>
      </button>
    </header>

    <div class="home-paper-stage" id="home-paper-stage">
  <!-- 01 / Workroom -->
  <div class="theme-home dark-home" data-home-sheet="workroom" hidden>
    <div class="dark-page">
      <div class="dark-meta">
        <span>남규모 · 컴퓨터소프트웨어공학과</span>
        <span class="dark-available">현재 연락 가능</span>
      </div>

      <section class="dark-grid" aria-label="포트폴리오 요약">
