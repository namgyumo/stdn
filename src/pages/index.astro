  </div>

  <!-- 02 / Notebook -->
  <div class="theme-home light-home" data-home-sheet="notebook">
    <main class="light-notebook">
      <div class="light-folio"><span>남규모의 개발 노트</span><span>개인 기록</span></div>
      <section class="light-grid" aria-label="포트폴리오 개발 노트">
