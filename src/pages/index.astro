          </ul>
        </article>

        <article class="light-note light-recent">
          <div class="light-label"><span>최근 글</span><span>{allPosts.length}개</span></div>
          <ul data-home-post-list>
            {posts.map((post) => (
              <li><a href={`/blog/${post.id}`} data-astro-prefetch><span>{formatShortDate(post.data.publishedAt)}</span><strong>{post.data.title}</strong><b>↗</b></a></li>
            ))}
          </ul>
