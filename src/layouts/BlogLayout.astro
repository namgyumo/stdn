---
import type { MarkdownHeading } from 'astro';
import PlainBlogShell from './PlainBlogShell.astro';
import TableOfContents from '@components/TableOfContents.astro';
import CopyCode from '@components/CopyCode.astro';
import ViewCount from '@components/ViewCount.astro';
import { formatDate } from '@lib/format';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  readTime?: string;
  headings: MarkdownHeading[];
  image?: string;
}

const { title, description, publishedAt, updatedAt, tags = [], readTime, headings, image } = Astro.props;
const slug = decodeURIComponent(
  Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, ''),
);
---

<PlainBlogShell
  title={title}
  description={description}
  type="article"
  publishedAt={publishedAt}
  image={image}
>
  <article class="blog-post">
    <header class="post-header">
      <p class="eyebrow">글</p>
      <h1>{title}</h1>
      {description && <p class="post-description">{description}</p>}
      <div class="post-meta">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        {updatedAt && <span>수정 {formatDate(updatedAt)}</span>}
        {readTime && <span>{readTime}</span>}
        <span><ViewCount slug={slug} /></span>
      </div>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a class="tag" href={`/blog/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
          ))}
        </div>
      )}
    </header>

    <TableOfContents headings={headings} />
    <div class="prose">
      <slot />
    </div>
    <slot name="post-footer" />
  </article>
  <CopyCode />
</PlainBlogShell>

<script>
  let renderingMermaid = false;

  async function renderMermaid() {
    if (renderingMermaid) return;
    const diagrams = [...document.querySelectorAll<HTMLElement>('.prose pre.mermaid:not([data-processed])')];
    if (diagrams.length === 0) return;
    renderingMermaid = true;
    try {
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({ startOnLoad: false, theme: 'neutral', securityLevel: 'strict' });
      await mermaid.run({ nodes: diagrams, suppressErrors: true });
    } finally {
      renderingMermaid = false;
    }
  }

  renderMermaid();
  document.addEventListener('astro:page-load', renderMermaid);
</script>
