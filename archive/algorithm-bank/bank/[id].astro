---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const problems = (await getCollection('problems')).sort(
    (a, b) => a.data.tierNum - b.data.tierNum || a.data.number - b.data.number,
  );
  return problems.map((problem, i) => ({
    params: { id: problem.id },
    props: {
      problem,
      prev: problems[i - 1] ?? null,
      next: problems[i + 1] ?? null,
    },
  }));
}

const { problem, prev, next } = Astro.props;
const d = problem.data;

const TIER_LABEL: Record<string, string> = {
  B3: '브론즈 III', B2: '브론즈 II', B1: '브론즈 I',
  S5: '실버 V', S4: '실버 IV', S3: '실버 III', S2: '실버 II', S1: '실버 I',
  G5: '골드 V', G4: '골드 IV', G3: '골드 III',
};

// 클라이언트로 넘길 데이터 (채점 케이스 = 예제 + 히든)
const clientData = {
  id: problem.id,
  cases: d.cases,
  starters: d.starters,
  timeLimitMs: d.timeLimitMs,
};
---

<BaseLayout
  title={`${d.title} · Bank`}
  description={d.statement.slice(0, 140)}
>
  <section class="container prob-wrap">
    <nav class="prob-top">
      <a href="/bank" class="btntext">← Bank</a>
      <span class="prob-top-meta">
        <span class={`tier-badge tier-${d.tier}`}>{TIER_LABEL[d.tier]}</span>
        {d.tags.map((t) => <span class="prob-tag">{t}</span>)}
      </span>
    </nav>

    <div class="prob-grid">
      <!-- 문제 -->
      <article class="prob-statement">
        <p class="eyebrow">// problem #{String(d.number).padStart(2, '0')}</p>
        <h1 class="prob-title">{d.title}</h1>
        <div class="prob-limits">
          <span>시간 제한 <b>{(d.timeLimitMs / 1000).toFixed(1)}초</b></span>
        </div>

        <p class="prob-body">{d.statement}</p>

        <h2 class="prob-h">입력</h2>
        <p class="prob-body">{d.inputDesc}</p>

        <h2 class="prob-h">출력</h2>
        <p class="prob-body">{d.outputDesc}</p>

        {d.constraints.length > 0 && (
          <>
            <h2 class="prob-h">제한</h2>
            <ul class="prob-constraints">
              {d.constraints.map((c) => <li>{c}</li>)}
            </ul>
          </>
        )}

        <h2 class="prob-h">예제</h2>
        <div class="prob-examples">
          {d.examples.map((ex, i) => (
            <div class="ex-pair">
              <div class="ex-col">
                <div class="ex-label">입력 {i + 1}</div>
                <pre class="ex-pre">{ex.in}</pre>
              </div>
              <div class="ex-col">
                <div class="ex-label">출력 {i + 1}</div>
                <pre class="ex-pre">{ex.out}</pre>
              </div>
            </div>
          ))}
        </div>
      </article>

      <!-- 에디터 -->
      <aside class="prob-editor" id="prob-editor">
        <div class="ed-toolbar">
          <select id="ed-lang" class="ed-lang" aria-label="언어 선택">
            <option value="c">C</option>
            <option value="cpp">C++</option>
            <option value="python">Python</option>
          </select>
          <div class="ed-actions">
            <button type="button" id="ed-reset" class="ed-btn ed-ghost" title="시작 코드로 되돌리기">reset</button>
            <button type="button" id="ed-run" class="ed-btn">▶ 실행</button>
            <button type="button" id="ed-submit" class="ed-btn ed-primary">제출</button>
          </div>
        </div>

        <textarea id="ed-code" class="ed-textarea" spellcheck="false"></textarea>

        <details class="ed-stdin">
          <summary>실행용 입력 (stdin)</summary>
          <textarea id="ed-input" class="ed-input" spellcheck="false" placeholder="여기에 입력을 넣고 ▶ 실행을 누르면 그 입력으로 한 번 실행합니다."></textarea>
        </details>

        <div class="ed-verdict" id="ed-verdict" hidden>
          <div class="verdict-head">
            <span class="verdict-tag" id="verdict-tag">—</span>
            <span class="verdict-sub" id="verdict-sub"></span>
          </div>
          <div class="verdict-cases" id="verdict-cases"></div>
          <pre class="verdict-out" id="verdict-out" hidden></pre>
        </div>
      </aside>
    </div>

    <nav class="prob-nav">
      {prev ? (
        <a class="pn-link" href={`/bank/${prev.id}`}>
          <span class="pn-dir">← prev</span>
          <span class="pn-title">{prev.data.title}</span>
        </a>
      ) : <span></span>}
      {next ? (
        <a class="pn-link pn-next" href={`/bank/${next.id}`}>
          <span class="pn-dir">next →</span>
          <span class="pn-title">{next.data.title}</span>
        </a>
      ) : <span></span>}
    </nav>
  </section>

  <!-- CodeMirror 5 (UMD, ClientRouter 안전) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/lib/codemirror.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/theme/material-darker.min.css" />
  <script is:inline src="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/lib/codemirror.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/mode/clike/clike.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/codemirror@5.65.16/mode/python/python.min.js"></script>

  <script type="application/json" id="prob-data" set:html={JSON.stringify(clientData)}></script>

  <script is:inline data-astro-rerun>
    (() => {
      const MODE = { c: 'text/x-csrc', cpp: 'text/x-c++src', python: 'text/x-python' };

      const norm = (s) =>
        (s || '')
          .replace(/\r\n/g, '\n')
          .split('\n')
          .map((l) => l.replace(/[ \t]+$/, ''))
          .join('\n')
          .replace(/\n+$/, '');

      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

      async function runOnce(language, source, stdin) {
        const res = await fetch('/api/run', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ language, source, stdin }),
        });
        if (!res.ok) {
          let msg = `실행 서버 오류 (${res.status})`;
          try { const j = await res.json(); if (j.message) msg = j.message; } catch {}
          throw new Error(msg);
        }
        return res.json();
      }

      function mount() {
        const host = document.getElementById('prob-editor');
        if (!host || host.dataset.mounted) return;
        if (typeof window.CodeMirror === 'undefined') {
          // CDN 아직 로드 전 — 다음 tick 재시도
          setTimeout(mount, 120);
          return;
        }
        host.dataset.mounted = '1';

        const dataEl = document.getElementById('prob-data');
        const data = JSON.parse(dataEl.textContent);
        const key = (lang) => `bank:${data.id}:${lang}`;

        const ta = document.getElementById('ed-code');
        const langSel = document.getElementById('ed-lang');
        const inputEl = document.getElementById('ed-input');
        const runBtn = document.getElementById('ed-run');
        const submitBtn = document.getElementById('ed-submit');
        const resetBtn = document.getElementById('ed-reset');
        const verdict = document.getElementById('ed-verdict');
        const vTag = document.getElementById('verdict-tag');
        const vSub = document.getElementById('verdict-sub');
        const vCases = document.getElementById('verdict-cases');
        const vOut = document.getElementById('verdict-out');

        let lang = localStorage.getItem(`bank:${data.id}:lang`) || 'c';
        if (!MODE[lang]) lang = 'c';
        langSel.value = lang;

        const starterFor = (l) => data.starters[l] || '';
        const loadCode = (l) => localStorage.getItem(key(l)) ?? starterFor(l);

        ta.value = loadCode(lang);
        const cm = window.CodeMirror.fromTextArea(ta, {
          lineNumbers: true,
          mode: MODE[lang],
          theme: 'material-darker',
          indentUnit: 4,
          tabSize: 4,
          smartIndent: true,
          lineWrapping: false,
        });
        cm.setSize('100%', 440);
        cm.on('change', () => localStorage.setItem(key(lang), cm.getValue()));

        langSel.addEventListener('change', () => {
          localStorage.setItem(key(lang), cm.getValue());
          lang = langSel.value;
          localStorage.setItem(`bank:${data.id}:lang`, lang);
          cm.setOption('mode', MODE[lang]);
          cm.setValue(loadCode(lang));
        });

        resetBtn.addEventListener('click', () => {
          cm.setValue(starterFor(lang));
          cm.focus();
        });

        const setBusy = (on, label) => {
          runBtn.disabled = on;
          submitBtn.disabled = on;
          if (on && label) { vTag.textContent = label; vTag.className = 'verdict-tag v-run'; }
        };

        const showVerdict = () => { verdict.hidden = false; };

        // ── 실행 (커스텀 입력 1회)
        runBtn.addEventListener('click', async () => {
          showVerdict();
          vCases.innerHTML = '';
          vOut.hidden = true;
          vSub.textContent = '';
          setBusy(true, '실행 중…');
          try {
            const r = await runOnce(lang, cm.getValue(), inputEl.value ?? '');
            const compileErr = r.compile && r.compile.code !== 0;
            if (compileErr) {
              vTag.textContent = 'CE'; vTag.className = 'verdict-tag v-ce';
              vSub.textContent = '컴파일 에러';
              vOut.hidden = false; vOut.textContent = (r.compile.stderr || r.compile.stdout || '').trim();
            } else {
              const run = r.run || {};
              vTag.textContent = 'DONE'; vTag.className = 'verdict-tag v-done';
              vSub.textContent = run.signal ? `종료 시그널: ${run.signal}` : `exit ${run.code ?? 0}`;
              vOut.hidden = false;
              vOut.textContent = (run.stdout || '') + (run.stderr ? `\n[stderr]\n${run.stderr}` : '') || '(출력 없음)';
            }
          } catch (e) {
            vTag.textContent = 'ERR'; vTag.className = 'verdict-tag v-ce';
            vSub.textContent = e.message || String(e);
          } finally {
            setBusy(false);
          }
        });

        // ── 제출 (전체 케이스 채점)
        submitBtn.addEventListener('click', async () => {
          showVerdict();
          vOut.hidden = true;
          vSub.textContent = '';
          const cases = data.cases || [];
          vCases.innerHTML = cases.map((_, i) => `<span class="cdot" data-i="${i}" title="케이스 ${i + 1}">${i + 1}</span>`).join('');
          setBusy(true, '채점 중…');
          const dots = [...vCases.querySelectorAll('.cdot')];
          const src = cm.getValue();
          let verdictType = 'AC';
          let failInfo = null;

          try {
            for (let i = 0; i < cases.length; i++) {
              dots[i].classList.add('c-running');
              const r = await runOnce(lang, src, cases[i].in);
              dots[i].classList.remove('c-running');

              if (r.compile && r.compile.code !== 0) {
                verdictType = 'CE';
                failInfo = { kind: 'ce', text: (r.compile.stderr || r.compile.stdout || '').trim() };
                dots[i].classList.add('c-fail');
                break;
              }
              const run = r.run || {};
              // TLE: Piston 이 시간초과로 프로세스를 죽이면 signal 세팅
              if (run.signal === 'SIGKILL' || run.signal === 'SIGXCPU') {
                verdictType = 'TLE'; dots[i].classList.add('c-fail');
                failInfo = { kind: 'tle', at: i + 1 }; break;
              }
              if ((run.code ?? 0) !== 0 && !run.stdout) {
                verdictType = 'RE'; dots[i].classList.add('c-fail');
                failInfo = { kind: 're', at: i + 1, text: (run.stderr || '').trim() }; break;
              }
              if (norm(run.stdout) !== norm(cases[i].out)) {
                verdictType = 'WA'; dots[i].classList.add('c-fail');
                failInfo = {
                  kind: 'wa', at: i + 1,
                  input: cases[i].in, expected: cases[i].out, got: run.stdout || '',
                };
                break;
              }
              dots[i].classList.add('c-pass');
              if (i < cases.length - 1) await sleep(320); // 공용 실행 서버 부하 완화
            }
          } catch (e) {
            verdictType = 'ERR'; failInfo = { kind: 'err', text: e.message || String(e) };
          }

          const cls = { AC: 'v-ac', WA: 'v-wa', TLE: 'v-tle', RE: 'v-re', CE: 'v-ce', ERR: 'v-ce' };
          vTag.textContent = verdictType;
          vTag.className = `verdict-tag ${cls[verdictType] || 'v-ce'}`;

          if (verdictType === 'AC') {
            vSub.textContent = `${cases.length}개 케이스 모두 통과 🎉`;
          } else if (failInfo?.kind === 'wa') {
            vSub.textContent = `${failInfo.at}번 케이스에서 틀렸습니다`;
            vOut.hidden = false;
            vOut.textContent =
              `[입력]\n${failInfo.input}\n\n[기대한 출력]\n${failInfo.expected}\n\n[내 출력]\n${(failInfo.got || '').trimEnd()}`;
          } else if (failInfo?.kind === 'tle') {
            vSub.textContent = `${failInfo.at}번 케이스 시간 초과`;
          } else if (failInfo?.kind === 're') {
            vSub.textContent = `${failInfo.at}번 케이스 런타임 에러`;
            if (failInfo.text) { vOut.hidden = false; vOut.textContent = failInfo.text; }
          } else if (failInfo?.kind === 'ce') {
            vSub.textContent = '컴파일 에러';
            vOut.hidden = false; vOut.textContent = failInfo.text;
          } else if (failInfo?.kind === 'err') {
            vSub.textContent = failInfo.text;
          }
          setBusy(false);
        });
      }

      mount();
    })();
  </script>
</BaseLayout>

<style>
  .prob-wrap { padding-top: 40px; }
  .prob-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; }
  .prob-top-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .prob-tag { font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-fg-dim); padding: 2px 7px; border: 1px solid rgba(224, 247, 250, 0.12); border-radius: 4px; }

  .tier-badge {
    display: inline-block; padding: 2px 9px; border-radius: 999px;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600;
    letter-spacing: 0.5px; white-space: nowrap; border: 1px solid;
  }
  .tier-B3 { color: #c98a5e; border-color: #6e4a30; background: rgba(201, 138, 94, 0.08); }
  .tier-B2 { color: #d29669; border-color: #7a5236; background: rgba(210, 150, 105, 0.09); }
  .tier-B1 { color: #dca678; border-color: #875c3e; background: rgba(220, 166, 120, 0.10); }
  .tier-S5 { color: #9aa6b2; border-color: #4a525c; background: rgba(154, 166, 178, 0.08); }
  .tier-S4 { color: #a8b4c0; border-color: #545d68; background: rgba(168, 180, 192, 0.09); }
  .tier-S3 { color: #b8c4d0; border-color: #5e6874; background: rgba(184, 196, 208, 0.10); }
  .tier-S2 { color: #c8d4e0; border-color: #68727e; background: rgba(200, 212, 224, 0.11); }
  .tier-S1 { color: #dce6f0; border-color: #7a8490; background: rgba(220, 230, 240, 0.13); }
  .tier-G5 { color: #e8c15a; border-color: #8a6f2a; background: rgba(232, 193, 90, 0.09); }
  .tier-G4 { color: #eecb62; border-color: #98792e; background: rgba(238, 203, 98, 0.10); }
  .tier-G3 { color: #f4d76c; border-color: #a68533; background: rgba(244, 215, 108, 0.12); }

  .prob-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: start; }

  .prob-statement { min-width: 0; }
  .prob-title { font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 8px 0 12px; line-height: 1.25; }
  .prob-limits { display: flex; gap: 16px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-fg-dim); margin-bottom: 22px; }
  .prob-limits b { color: var(--color-fg); font-weight: 600; }
  .prob-h { font-size: 0.95rem; letter-spacing: 1px; text-transform: uppercase; color: var(--color-accent); margin: 26px 0 8px; font-family: var(--font-mono); }
  .prob-body { color: var(--color-fg); line-height: 1.75; margin: 0; white-space: pre-wrap; word-break: keep-all; }
  .prob-constraints { margin: 0; padding-left: 18px; color: var(--color-fg); line-height: 1.9; }
  .prob-constraints li { font-family: var(--font-mono); font-size: 0.82rem; }

  .prob-examples { display: grid; gap: 14px; }
  .ex-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .ex-label { font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-fg-dim); margin-bottom: 5px; letter-spacing: 0.5px; }
  .ex-pre {
    margin: 0; padding: 12px 14px;
    background: var(--color-bg-elev);
    border: 1px solid rgba(224, 247, 250, 0.1);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.55;
    color: var(--color-fg); white-space: pre; overflow-x: auto;
  }

  /* 에디터 패널 */
  .prob-editor { position: sticky; top: 84px; min-width: 0; }
  .ed-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
  .ed-lang {
    padding: 7px 12px; border-radius: var(--radius-sm);
    border: 1px solid rgba(224, 247, 250, 0.16); background: var(--color-bg-elev);
    color: var(--color-fg); font-family: var(--font-mono); font-size: 0.82rem;
  }
  .ed-actions { display: flex; gap: 8px; }
  .ed-btn {
    padding: 7px 14px; border-radius: var(--radius-sm); cursor: pointer;
    border: 1px solid rgba(224, 247, 250, 0.18); background: var(--color-bg-elev);
    color: var(--color-fg); font-family: var(--font-mono); font-size: 0.8rem;
    transition: all var(--dur-fast) var(--ease);
  }
  .ed-btn:hover:not(:disabled) { border-color: rgba(224, 247, 250, 0.4); }
  .ed-btn:disabled { opacity: 0.5; cursor: wait; }
  .ed-ghost { color: var(--color-fg-dim); }
  .ed-primary { border-color: var(--color-accent); color: var(--color-accent); }
  .ed-primary:hover:not(:disabled) { background: rgba(193, 255, 0, 0.1); box-shadow: var(--glow-lime-soft); }

  .ed-textarea { display: none; }
  .prob-editor :global(.CodeMirror) {
    height: 440px;
    border: 1px solid rgba(224, 247, 250, 0.14);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .ed-stdin { margin-top: 12px; }
  .ed-stdin summary { cursor: pointer; font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-fg-dim); }
  .ed-input {
    width: 100%; min-height: 70px; margin-top: 8px; padding: 10px 12px; resize: vertical;
    border: 1px solid rgba(224, 247, 250, 0.14); border-radius: var(--radius-sm);
    background: var(--color-bg-elev); color: var(--color-fg);
    font-family: var(--font-mono); font-size: 0.8rem;
  }

  .ed-verdict { margin-top: 14px; padding: 14px; border: 1px solid rgba(224, 247, 250, 0.12); border-radius: var(--radius-sm); background: var(--color-bg-elev); }
  .verdict-head { display: flex; align-items: center; gap: 12px; }
  .verdict-tag {
    font-family: var(--font-mono); font-weight: 700; font-size: 0.9rem;
    padding: 4px 12px; border-radius: var(--radius-sm); border: 1px solid;
  }
  .v-run, .v-done { color: var(--color-fg-dim); border-color: rgba(224,247,250,0.2); }
  .v-ac { color: #7dff9b; border-color: #7dff9b; background: rgba(125,255,155,0.08); }
  .v-wa { color: var(--color-pink); border-color: var(--color-pink); background: rgba(255,0,60,0.08); }
  .v-tle { color: #ffb545; border-color: #ffb545; background: rgba(255,181,69,0.08); }
  .v-re { color: #ff7a45; border-color: #ff7a45; background: rgba(255,122,69,0.08); }
  .v-ce { color: #c58cff; border-color: #c58cff; background: rgba(180,140,255,0.08); }
  .verdict-sub { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-fg-dim); }

  .verdict-cases { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 12px; }
  .cdot {
    width: 24px; height: 24px; display: grid; place-items: center;
    font-family: var(--font-mono); font-size: 0.68rem; border-radius: 5px;
    border: 1px solid rgba(224, 247, 250, 0.16); color: var(--color-fg-dim);
  }
  .cdot.c-running { border-color: var(--color-accent); color: var(--color-accent); animation: pulse 0.8s infinite; }
  .cdot.c-pass { border-color: #7dff9b; color: #7dff9b; background: rgba(125,255,155,0.1); }
  .cdot.c-fail { border-color: var(--color-pink); color: var(--color-pink); background: rgba(255,0,60,0.1); }
  @keyframes pulse { 50% { opacity: 0.4; } }

  .verdict-out {
    margin: 12px 0 0; padding: 12px; max-height: 260px; overflow: auto;
    background: #0b0b0b; border: 1px solid rgba(224, 247, 250, 0.1); border-radius: var(--radius-sm);
    font-family: var(--font-mono); font-size: 0.76rem; line-height: 1.5; color: var(--color-fg);
    white-space: pre-wrap; word-break: break-all;
